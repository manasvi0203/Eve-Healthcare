NODE_ENV=development
PORT=3000

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eve_healthcare

# Used automatically when NODE_ENV=test (falls back to DATABASE_URL if unset)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eve_healthcare_test

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1h

BCRYPT_SALT_ROUNDS=10

# Probability (0-1) that a simulated payment succeeds when no forceOutcome is given
PAYMENT_SUCCESS_RATE=0.8
